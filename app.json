      },
      "predictiveBackGestureEnabled": false,
      "package": "com.niishhh.kojipos"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "7795a91c-1ef0-4761-83df-074f3662eed4"
      }
    }
  }
}
