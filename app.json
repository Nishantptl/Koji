{
  "expo": {
    "name": "Kōji",
    "slug": "koji",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F8F9F5"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.niishhh.kojipos",
      "permissions": [
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Kōji to access your contacts to sync customer phone numbers."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ff6b13df-ff61-4632-b7e3-2401f741b12d"
      }
    }
  }
}